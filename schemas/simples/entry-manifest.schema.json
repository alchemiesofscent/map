{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/simples/entry-manifest.schema.json",
  "title": "Simple medicine pilot entry manifest",
  "type": "object",
  "required": ["metadata", "entries", "overlap_terms", "galen_materia_context"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "manifest_id",
        "stage",
        "schema_path",
        "aetius_root",
        "source_csv_paths",
        "galen_materia_source_path"
      ],
      "properties": {
        "manifest_id": { "type": "string" },
        "stage": { "type": "string" },
        "schema_path": { "type": "string" },
        "aetius_root": { "type": "string" },
        "source_csv_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "galen_materia_source_path": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "minItems": 1
    },
    "overlap_terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlapTerm" },
      "minItems": 1
    },
    "galen_materia_context": {
      "type": "array",
      "items": { "$ref": "#/$defs/galenMateriaContext" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "selection_sets",
        "source_csv_path",
        "source_row_idx",
        "witness_slug",
        "author",
        "work",
        "book",
        "chapter",
        "lemma",
        "lemma_en",
        "edition_pages",
        "greek_entry_text"
      ],
      "properties": {
        "entry_id": { "type": "string" },
        "selection_sets": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_csv_path": { "type": "string" },
        "source_row_idx": { "type": "string" },
        "witness_slug": { "type": "string" },
        "author": { "type": "string", "minLength": 1 },
        "work": { "type": "string", "minLength": 1 },
        "book": { "type": "string" },
        "chapter": { "type": "string" },
        "book_no_gr": { "type": "string" },
        "chapter_no_gr": { "type": "string" },
        "chapter_heading_gr": { "type": "string" },
        "section_heading_gr": { "type": "string" },
        "lemma": { "type": "string", "minLength": 1 },
        "lemma_en": { "type": "string" },
        "variant_or_parallel_gr": { "type": "string" },
        "variant_or_parallel_en": { "type": "string" },
        "entry_en": { "type": "string" },
        "category": { "type": "string" },
        "edition_pages": { "type": "string" },
        "greek_entry_text": { "type": "string", "minLength": 1 },
        "lemma_derived": { "type": "boolean" },
        "derived_from": { "type": "string" },
        "matched_overlap_terms": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "overlapTerm": {
      "type": "object",
      "required": ["term_id", "label", "greek_forms", "selected_entry_ids"],
      "properties": {
        "term_id": { "type": "string" },
        "label": { "type": "string" },
        "greek_forms": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "selected_entry_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "galenMateriaContext": {
      "type": "object",
      "required": [
        "materia_key",
        "display_name",
        "greek_name",
        "category",
        "source_json_path",
        "place_links"
      ],
      "properties": {
        "materia_key": { "type": "string" },
        "display_name": { "type": "string" },
        "greek_name": { "type": "string" },
        "category": { "type": "string" },
        "source_json_path": { "type": "string" },
        "description": { "type": "string" },
        "place_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["place_key", "relation", "passage_id", "evidence_phrase"],
            "properties": {
              "place_key": { "type": "string" },
              "relation": {
                "type": "string",
                "enum": [
                  "acquired",
                  "observed",
                  "sourced_from",
                  "tested",
                  "prepared",
                  "named_variety_from",
                  "grows_at",
                  "produced_at",
                  "traded_from",
                  "compared_with",
                  "rejected"
                ]
              },
              "passage_id": { "type": "string" },
              "evidence_phrase": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
