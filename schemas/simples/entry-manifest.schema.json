{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/simples/entry-manifest.schema.json",
  "title": "Materia TEI ingredient journey manifest",
  "type": "object",
  "required": ["metadata", "ingredients", "entries"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "manifest_id",
        "stage",
        "schema_path",
        "source_boundary",
        "source_registry_path",
        "draft_translations_path",
        "source_tei_paths"
      ],
      "properties": {
        "manifest_id": { "type": "string" },
        "stage": { "type": "string" },
        "schema_path": { "type": "string" },
        "source_boundary": { "const": "data/tei" },
        "source_registry_path": { "type": "string" },
        "draft_translations_path": { "type": "string" },
        "source_tei_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "ingredients": {
      "type": "array",
      "items": { "$ref": "#/$defs/ingredient" },
      "minItems": 5,
      "maxItems": 5
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": [
        "ingredient_key",
        "display_name",
        "greek_name",
        "entry_ids",
        "passage_ids",
        "view_id"
      ],
      "properties": {
        "ingredient_key": {
          "type": "string",
          "enum": ["balsamum", "cardamom", "calamus", "schoinos", "myrrh"]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "greek_name": { "type": "string", "minLength": 1 },
        "entry_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "passage_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "view_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "selection_sets",
        "ingredient_keys",
        "source_registry_id",
        "source_tei_path",
        "source_raw_tei_path",
        "source_tei_annotated",
        "source_entry_index",
        "source_xml_id",
        "witness_slug",
        "author",
        "work",
        "book",
        "chapter",
        "lemma",
        "lemma_en",
        "edition_pages",
        "greek_entry_text",
        "evidence_authority"
      ],
      "properties": {
        "entry_id": { "type": "string" },
        "selection_sets": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "ingredient_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["balsamum", "cardamom", "calamus", "schoinos", "myrrh"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_registry_id": { "type": "string" },
        "source_tei_path": { "type": "string" },
        "source_raw_tei_path": { "type": "string" },
        "source_tei_annotated": { "type": "boolean" },
        "source_entry_index": { "type": "string" },
        "source_xml_id": { "type": "string" },
        "witness_slug": { "type": "string" },
        "author": { "type": "string", "minLength": 1 },
        "work": { "type": "string", "minLength": 1 },
        "book": { "type": "string" },
        "chapter": { "type": "string" },
        "book_no_gr": { "type": "string" },
        "chapter_no_gr": { "type": "string" },
        "chapter_heading_gr": { "type": "string" },
        "section_heading_gr": { "type": "string" },
        "lemma": { "type": "string", "minLength": 1 },
        "lemma_en": { "type": "string" },
        "variant_or_parallel_gr": { "type": "string" },
        "variant_or_parallel_en": { "type": "string" },
        "entry_en": { "type": "string" },
        "translation_en_authority": { "type": "string" },
        "translation_en_source": { "type": "string" },
        "evidence_authority": { "const": "greek_tei" },
        "category": { "type": "string" },
        "edition_pages": { "type": "string" },
        "greek_entry_text": { "type": "string", "minLength": 1 },
        "lemma_derived": { "type": "boolean" },
        "derived_from": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
