{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/simples/provenance-entry-claims.schema.json",
  "title": "TEI-derived Materia provenance claims",
  "type": "object",
  "required": ["metadata", "counts", "reports", "claims"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "artifact_id",
        "stage",
        "source_manifest_path",
        "source_gazetteer_path",
        "source_tei_paths",
        "notes"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "tei_place_claims_in",
        "accepted_claims",
        "ingredients_with_claims",
        "entries_with_claims"
      ]
    },
    "reports": { "type": "object" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "entry_id",
          "passage_id",
          "ingredient_key",
          "lemma",
          "author",
          "work",
          "book",
          "chapter",
          "source_tei_path",
          "claim_order",
          "place_surface",
          "relation",
          "qualifier",
          "claim_group",
          "accepted_pleiades_id",
          "accepted_pleiades_uri",
          "place_label",
          "evidence_phrase",
          "certainty",
          "review_decision_source",
          "entry_claim_source",
          "final_decision"
        ],
        "properties": {
          "ingredient_key": {
            "type": "string",
            "enum": ["balsamum", "cardamom", "calamus", "schoinos", "myrrh"]
          },
          "relation": {
            "type": "string",
            "enum": [
              "named_variety_from",
              "grows_at",
              "produced_at",
              "sourced_from",
              "acquired",
              "observed",
              "tested",
              "prepared"
            ]
          },
          "claim_order": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "consensus_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "final_decision": { "const": "accept" },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
