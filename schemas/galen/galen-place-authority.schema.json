{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/galen/galen-place-authority.schema.json",
  "title": "Galen place authority file",
  "type": "array",
  "$defs": {
    "certainty": {
      "type": "string",
      "enum": ["secure", "probable", "ambiguous", "not_found"]
    },
    "placeKey": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableString": {
      "type": ["string", "null"]
    }
  },
  "items": {
    "type": "object",
    "required": [
      "place_key",
      "display_name",
      "ancient_names_in_galen",
      "place_type",
      "lat",
      "lon",
      "certainty",
      "pleiades_id",
      "pleiades_uri",
      "coordinates_source",
      "notes"
    ],
    "properties": {
      "place_key": { "$ref": "#/$defs/placeKey" },
      "display_name": { "type": "string" },
      "ancient_names_in_galen": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["surface", "passage_id"],
          "properties": {
            "surface": { "type": "string" },
            "passage_id": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "place_type": {
        "type": "string",
        "enum": ["city", "port", "region", "island", "mine", "sanctuary", "sea", "river", "mountain"]
      },
      "lat": { "$ref": "#/$defs/nullableNumber" },
      "lon": { "$ref": "#/$defs/nullableNumber" },
      "certainty": { "$ref": "#/$defs/certainty" },
      "pleiades_id": { "$ref": "#/$defs/nullableString" },
      "pleiades_uri": { "$ref": "#/$defs/nullableString" },
      "coordinates_source": { "type": "string" },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  }
}
